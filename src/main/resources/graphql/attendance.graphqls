# =====================================================
# ATTENDANCE MODULE GRAPHQL SCHEMA
# =====================================================
# Types, Inputs, Queries, Mutations, and Enums for
# the Attendance Module (Shifts, Holidays, Policies,
# Punch Logs, Daily Attendance, Regularizations)
# =====================================================

# ====================
# TYPES
# ====================

# Shift - Work shift definition
type Shift {
  id: ID!
  tenantId: ID!
  companyId: ID
  code: String!
  name: String!
  description: String
  shiftType: ShiftType!
  timingMode: TimingMode!
  startTime: String!
  endTime: String!
  workingHours: Float!
  breakDurationMinutes: Int
  isNightShift: Boolean
  isOtEligible: Boolean
  firstHalfEnd: String
  secondHalfStart: String
  isActive: Boolean
  displayOrder: Int
  breaks: [ShiftBreak]
}

# ShiftBreak - Break periods within a shift
type ShiftBreak {
  id: ID!
  shiftId: ID!
  breakType: BreakType!
  name: String
  startTime: String!
  endTime: String!
  durationMinutes: Int!
  isPaid: Boolean
}

# Holiday - Company holidays
type Holiday {
  id: ID!
  tenantId: ID!
  date: String!
  name: String!
  holidayType: String!
  category: HolidayCategory!
  isMandatory: Boolean
  isNiActCompliant: Boolean
  isFloating: Boolean
  religion: Religion
  description: String
  companies: [ID]
  locations: [ID]
}

# AttendancePolicyTemplate - Attendance rules and criteria
type AttendancePolicyTemplate {
  id: ID!
  tenantId: ID!
  companyId: ID
  templateCode: String!
  templateName: String!
  description: String
  changeNotes: String
  isDefault: Boolean
  isActive: Boolean
  priority: Int
  version: String
  effectiveFrom: String!
  effectiveTo: String
  criteria: JSON
  applicableShifts: [Shift]
  weekoffRules: [WeekoffRule]
  incentives: [PolicyIncentive]
  treatAbsenceAsLeave: Boolean
  markHolidays: Boolean
  markWeekoffs: Boolean
  minHoursForPresent: Float
  minHoursForHalfDay: Float
  graceInMinutes: Int
  graceOutMinutes: Int
  firstHalfEnd: String
  secondHalfStart: String
  isOTEligible: Boolean
  hasIncentives: Boolean
  createdAt: String
  updatedAt: String
}

# WeekoffRule - Weekly off patterns
type WeekoffRule {
  id: ID!
  dayOfWeek: WeekDay!
  pattern: WeekoffPattern!
}

# PolicyIncentive - Attendance-based incentives
type PolicyIncentive {
  id: ID!
  payheadCode: String!
  calcType: IncentiveCalcType!
  overrideValue: Float
  isActive: Boolean
}

# PunchLog - Raw punch records
type PunchLog {
  id: ID!
  tenantId: ID!
  companyId: ID
  employeeId: ID
  company: Company
  employee: Employee
  biometricId: String
  deviceId: String
  deviceName: String
  location: String
  punchTime: String!
  punchType: PunchType!
  verifyMode: VerifyMode
  punchSource: PunchSource!
  status: PunchStatus!
  createdAt: String
}

# DailyAttendance - Processed daily attendance
type DailyAttendance {
  id: ID!
  tenantId: ID!
  companyId: ID!
  employeeId: ID!
  company: Company
  employee: Employee
  attendanceDate: String!
  shift: Shift
  firstPunchIn: String
  lastPunchOut: String
  totalHoursWorked: Float
  overtimeHours: Float
  status: AttendanceStatus!
  lateByMinutes: Int
  earlyLeavingMinutes: Int
  punchCount: Int
  hasMissedPunch: Boolean
  missedPunchType: MissedPunchType
  isRegularized: Boolean
  remarks: String
  createdAt: String
  updatedAt: String
  # Denormalized shift info for Employee Portal display
  shiftName: String
  shiftCode: String
  shiftStartTime: String
  shiftEndTime: String
  # Regularization info
  pendingRegularization: AttendanceRegularization
}

# AttendanceRegularization - Attendance correction requests
type AttendanceRegularization {
  id: ID!
  tenantId: ID!
  companyId: ID!
  employeeId: ID!
  company: Company
  employee: Employee
  dailyAttendanceId: ID
  dailyAttendance: DailyAttendance
  regularizationType: RegularizationType!
  regularizationDate: String!
  originalPunchIn: String
  originalPunchOut: String
  regularizedPunchIn: String
  regularizedPunchOut: String
  reason: String!
  status: ApprovalStatus!
  approvedBy: ID
  approvedByUser: UserAccount
  approvedAt: String
  rejectionReason: String
  approverRemarks: String
  createdAt: String
  updatedAt: String
}

# ====================
# INPUTS
# ====================

input ShiftInput {
  code: String!
  name: String!
  description: String
  shiftType: ShiftType!
  timingMode: TimingMode!
  startTime: String!
  endTime: String!
  workingHours: Float!
  breakDurationMinutes: Int
  isNightShift: Boolean
  isOtEligible: Boolean
  firstHalfEnd: String
  secondHalfStart: String
  isActive: Boolean
  displayOrder: Int
  breaks: [ShiftBreakInput]
}

input ShiftBreakInput {
  breakType: BreakType!
  name: String
  startTime: String!
  endTime: String!
  durationMinutes: Int!
  isPaid: Boolean
}

input HolidayInput {
  date: String!
  name: String!
  holidayType: String!
  category: HolidayCategory!
  isMandatory: Boolean
  isNiActCompliant: Boolean
  isFloating: Boolean
  religion: Religion
  description: String
  companyIds: [ID]
  locationIds: [ID]
}

input AttendancePolicyTemplateInput {
  templateCode: String!
  templateName: String!
  description: String
  changeNotes: String
  isDefault: Boolean
  isActive: Boolean
  priority: Int
  effectiveFrom: String!
  effectiveTo: String
  criteria: JSON
  applicableShiftIds: [ID]
  weekoffRules: [WeekoffRuleInput]
  incentives: [PolicyIncentiveInput]
  treatAbsenceAsLeave: Boolean
  markHolidays: Boolean
  markWeekoffs: Boolean
  minHoursForPresent: Float
  minHoursForHalfDay: Float
  graceInMinutes: Int
  graceOutMinutes: Int
  firstHalfEnd: String
  secondHalfStart: String
  isOTEligible: Boolean
  hasIncentives: Boolean
}

input WeekoffRuleInput {
  dayOfWeek: WeekDay!
  pattern: WeekoffPattern!
}

input PolicyIncentiveInput {
  payheadCode: String!
  calcType: IncentiveCalcType!
  overrideValue: Float
  isActive: Boolean
}

input PunchLogInput {
  employeeId: ID
  biometricId: String
  deviceId: String
  deviceName: String
  location: String
  punchTime: String!
  punchType: PunchType!
  verifyMode: VerifyMode
  punchSource: PunchSource!
}

input RegularizationInput {
  employeeId: ID                         # For self-service - employee's own ID
  dailyAttendanceId: ID
  regularizationType: RegularizationType!
  regularizationDate: String!
  missedPunchType: MissedPunchType       # Which punch was missed (IN/OUT/BOTH)
  originalPunchIn: String                # For reference
  originalPunchOut: String
  regularizedPunchIn: String
  regularizedPunchOut: String
  reason: String!
}

# ====================
# ATTENDANCE CAPTURE TYPES
# ====================

# Bulk Manual Entry Types
input BulkAttendanceEntryInput {
  employeeId: ID!
  date: String!
  punchIn: String
  punchOut: String
  status: AttendanceStatus!
  remarks: String
}

type BulkEntryResult {
  successCount: Int!
  failedCount: Int!
  errors: [BulkEntryError]
}

type BulkEntryError {
  employeeId: ID!
  date: String!
  message: String!
}

# Excel Import Types
input ExcelRowInput {
  rowNumber: Int!
  employeeId: String!          # Employee code (e.g., "EMP001")
  date: String!                # DD/MM/YYYY format
  inTime: String               # HH:MM (24h)
  outTime: String              # HH:MM (24h)
  status: String!              # P, A, HD, WO, H, L, OD
  remarks: String
}

# Input for updating attendance record (Time Center inline editing)
input AttendanceUpdateInput {
  attendanceId: ID!            # Required: ID of daily_attendance record
  firstPunchIn: String         # Optional: HH:MM format (24-hour)
  lastPunchOut: String         # Optional: HH:MM format (24-hour)
  status: AttendanceStatus     # Optional: PRESENT, ABSENT, etc.
  remarks: String              # Optional: Notes/comments
}

type ValidationResult {
  totalRows: Int!
  validRecords: Int!
  warnings: [ValidationIssue]
  errors: [ValidationIssue]
}

type ValidationIssue {
  rowNumber: Int!
  column: String!
  value: String
  message: String!
  severity: IssueSeverity!
}

type ImportResult {
  importedCount: Int!
  skippedCount: Int!
  errors: [ImportError]
  importLogId: ID
}

type ImportError {
  rowNumber: Int!
  employeeId: String
  message: String!
}

# Employee Search Types for Attendance
type EmployeeBasic {
  id: ID!
  employeeCode: String!
  fullName: String!
  designation: String
  department: String
}

type EmployeeAttendanceRow {
  employeeId: ID!
  employeeCode: String!
  employeeName: String!
  designation: String
  department: String
  existingAttendance: DailyAttendance   # null if no entry for date
}

# ====================
# QUERIES
# ====================
# NOTE: tenantId is required for all queries (multi-tenancy pattern)

extend type Query {
  # Shifts
  shifts(tenantId: String!, companyId: ID, isActive: Boolean, shiftType: ShiftType, searchQuery: String): [Shift]
  shift(tenantId: String!, id: ID!): Shift

  # Holidays
  holidays(tenantId: String!, companyId: ID, year: Int, locationId: ID, searchQuery: String): [Holiday]
  holiday(tenantId: String!, id: ID!): Holiday

  # Attendance Policy Templates
  attendancePolicyTemplates(tenantId: String!, companyId: ID, isActive: Boolean, searchQuery: String): [AttendancePolicyTemplate]
  attendancePolicyTemplate(tenantId: String!, id: ID!): AttendancePolicyTemplate

  # Punch Logs
  punchLogs(tenantId: String!, companyId: ID, dateFrom: String!, dateTo: String!, employeeId: ID, status: PunchStatus): [PunchLog]

  # Daily Attendance (with Time Center filters)
  dailyAttendance(tenantId: String!, companyId: ID!, dateFrom: String!, dateTo: String!, employeeId: ID, status: AttendanceStatus, locationId: ID, departmentId: ID, searchQuery: String): [DailyAttendance]
  employeeAttendance(tenantId: String!, employeeId: ID!, dateFrom: String!, dateTo: String!): [DailyAttendance]

  # Regularizations (with Time Center filters and role-based access control)
  # Note: userId parameter is temporary until proper authentication context is implemented
  # When userId is provided, filtering is based on user's role:
  # - ADMIN: sees all regularizations
  # - MANAGER: sees only direct reportees' regularizations
  # - EMPLOYEE: sees only their own regularizations
  regularizations(tenantId: String!, companyId: ID, status: ApprovalStatus, employeeId: ID, dateFrom: String, dateTo: String, locationId: ID, departmentId: ID, searchQuery: String, userId: ID): [AttendanceRegularization]
  pendingRegularizations(tenantId: String!, companyId: ID!): [AttendanceRegularization]

  # Employee Self-Service - Regularization History
  myRegularizations(tenantId: String!, employeeId: ID!, status: ApprovalStatus, dateFrom: String, dateTo: String): [AttendanceRegularization]

  # Attendance Capture - Employee Lookup
  searchEmployeesForAttendance(tenantId: String!, companyId: ID!, locationId: ID, departmentId: ID, searchText: String, limit: Int): [EmployeeBasic]
  employeesForAttendanceGrid(tenantId: String!, companyId: ID!, locationId: ID, departmentId: ID, date: String!): [EmployeeAttendanceRow]

  # Biometric Sync
  supabaseRecordCount: Int

  # Attendance Import History
  getAttendanceImportHistory(tenantId: String!, companyId: ID!, limit: Int, offset: Int, status: ImportStatus, fromDate: String, toDate: String): ImportLogPage!
  getAttendanceImportDetails(tenantId: String!, importId: ID!): AttendanceImportLog
  getImportErrors(tenantId: String!, importId: ID!, limit: Int, offset: Int): [AttendanceImportErrorDetail!]!
}

# ====================
# MUTATIONS
# ====================
# NOTE: tenantId is required for all mutations (multi-tenancy pattern)

extend type Mutation {
  # Shifts
  createShift(tenantId: String!, companyId: ID, input: ShiftInput!): Shift
  updateShift(tenantId: String!, id: ID!, input: ShiftInput!): Shift
  deleteShift(tenantId: String!, id: ID!): Boolean

  # Holidays
  createHoliday(tenantId: String!, input: HolidayInput!): Holiday
  updateHoliday(tenantId: String!, id: ID!, input: HolidayInput!): Holiday
  deleteHoliday(tenantId: String!, id: ID!): Boolean
  bulkCreateHolidays(tenantId: String!, inputs: [HolidayInput]!): [Holiday]

  # Attendance Policy Templates
  createAttendancePolicyTemplate(tenantId: String!, companyId: ID, input: AttendancePolicyTemplateInput!): AttendancePolicyTemplate
  updateAttendancePolicyTemplate(tenantId: String!, id: ID!, input: AttendancePolicyTemplateInput!): AttendancePolicyTemplate
  deleteAttendancePolicyTemplate(tenantId: String!, id: ID!): Boolean
  setDefaultAttendancePolicyTemplate(tenantId: String!, id: ID!): AttendancePolicyTemplate

  # Punch Logs
  recordPunch(tenantId: String!, companyId: ID!, input: PunchLogInput!): PunchLog
  bulkImportPunches(tenantId: String!, companyId: ID!, inputs: [PunchLogInput]!): Int
  mapUnmatchedPunch(tenantId: String!, punchLogId: ID!, employeeId: ID!): PunchLog

  # Daily Attendance
  processAttendance(tenantId: String!, companyId: ID!, date: String!): Int
  manualAttendanceEntry(tenantId: String!, companyId: ID!, employeeId: ID!, date: String!, punchIn: String, punchOut: String, status: AttendanceStatus!, remarks: String): DailyAttendance

  # Attendance Capture - Bulk Manual Entry
  bulkManualAttendanceEntry(tenantId: String!, companyId: ID!, entries: [BulkAttendanceEntryInput]!): BulkEntryResult

  # Attendance Capture - Excel Import
  validateAttendanceImport(tenantId: String!, companyId: ID!, rows: [ExcelRowInput]!): ValidationResult
  importAttendanceFromExcel(tenantId: String!, companyId: ID!, rows: [ExcelRowInput]!, overwriteExisting: Boolean, fileName: String, fileSizeBytes: Int, importedByUserId: ID): ImportResult

  # Regularizations
  submitRegularization(tenantId: String!, companyId: ID!, input: RegularizationInput!): AttendanceRegularization
  approveRegularization(tenantId: String!, id: ID!, remarks: String): AttendanceRegularization
  rejectRegularization(tenantId: String!, id: ID!, reason: String!): AttendanceRegularization

  # Bulk Regularizations (Time Center)
  bulkApproveRegularizations(tenantId: String!, ids: [ID!]!, remarks: String): BulkRegularizationResult
  bulkRejectRegularizations(tenantId: String!, ids: [ID!]!, reason: String!): BulkRegularizationResult

  # Time Center - Status Updates
  updateAttendanceStatus(tenantId: String!, attendanceId: ID!, newStatus: AttendanceStatus!, reason: String!): DailyAttendance
  bulkUpdateAttendanceStatus(tenantId: String!, attendanceIds: [ID!]!, newStatus: AttendanceStatus!, reason: String!): BulkStatusUpdateResult

  # Time Center - Attendance Record Update (inline editing)
  updateAttendanceRecord(tenantId: String!, input: AttendanceUpdateInput!): DailyAttendance

  # Biometric Sync
  syncBiometricData(tenantId: String!, companyId: ID): BiometricSyncResult
  testSupabaseConnection: Boolean
}

# ====================
# TIME CENTER RESULT TYPES
# ====================

# Result type for bulk status update operation
type BulkStatusUpdateResult {
  successCount: Int!
  failedCount: Int!
  results: [StatusUpdateResultItem]
}

type StatusUpdateResultItem {
  attendanceId: ID
  status: String
  error: String
}

# Result type for bulk regularization operations
type BulkRegularizationResult {
  successCount: Int!
  failedCount: Int!
  results: [RegularizationResultItem]
}

type RegularizationResultItem {
  id: ID
  status: String
  error: String
}

# ====================
# ATTENDANCE IMPORT HISTORY TYPES
# ====================

# Import history log entry
type AttendanceImportLog {
  id: ID!
  tenantId: String!
  company: Company
  fileName: String!
  fileSizeBytes: Int
  totalRows: Int!
  importedCount: Int!
  skippedCount: Int!
  errorCount: Int!
  status: ImportStatus!
  errorMessage: String
  startedAt: String
  completedAt: String
  processingTimeMs: Int
  importedBy: UserAccount
  createdAt: String!
}

# Import log page with pagination
type ImportLogPage {
  items: [AttendanceImportLog!]!
  totalCount: Int!
  pageInfo: ImportPageInfo!
}

type ImportPageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  currentPage: Int!
  totalPages: Int!
}

# Import error detail
type AttendanceImportErrorDetail {
  id: ID!
  rowNumber: Int!
  employeeId: String
  columnName: String
  errorType: String!
  errorMessage: String!
}

# Import status enum
enum ImportStatus {
  PENDING
  PROCESSING
  SUCCESS
  PARTIAL
  FAILED
}

# Biometric sync result type
type BiometricSyncResult {
  totalFetched: Int!
  inserted: Int!
  skippedDuplicate: Int!
  skippedNoEmployee: Int!
  failed: Int!
  message: String
}

# ====================
# ENUMS
# ====================

enum ShiftType {
  GENERAL
  ROTATIONAL
  NIGHT
  FLEXI
}

enum TimingMode {
  FIXED
  FILO
  FLEXI
}

enum BreakType {
  TEA
  LUNCH
  DINNER
  SHORT
  OTHER
}

enum HolidayCategory {
  NATIONAL
  REGIONAL
  COMPANY
  OPTIONAL
}

enum Religion {
  HINDU
  ISLAMIC
  CHRISTIAN
  SIKH
  BUDDHIST
  JAIN
  OTHER
}

# Named WeekDay to avoid conflict with java.time.DayOfWeek
enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum WeekoffPattern {
  EVERY_WEEK
  FIRST_ONLY
  SECOND_ONLY
  THIRD_ONLY
  FOURTH_ONLY
  FIFTH_ONLY
  FIRST_THIRD
  SECOND_FOURTH
  FIRST_THIRD_FIFTH
  SECOND_FOURTH_FIFTH
  ALL_EXCEPT_FIRST
  ALL_EXCEPT_FIFTH
}

enum IncentiveCalcType {
  FIXED
  FORMULA
  PERCENTAGE
  DAYS_BASED
}

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  BIOMETRIC
  PORTAL
  MOBILE
  EXCEL_IMPORT
  MANUAL
  API
}

enum PunchStatus {
  MATCHED
  UNMATCHED
}

enum VerifyMode {
  FINGER
  CARD
  FACE
  PIN
  PASSWORD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  HALF_DAY
  WEEKLY_OFF
  HALF_ABSENT
  ON_DUTY
}

enum MissedPunchType {
  MISSING_IN
  MISSING_OUT
  ODD_PUNCHES
  SINGLE_PUNCH
}

enum RegularizationType {
  MISSING_IN
  MISSING_OUT
  MISSED_PUNCH
  WRONG_PUNCH
  LATE_ENTRY
  EARLY_EXIT
  ON_DUTY
  SYSTEM_ERROR
  OTHER
}

enum IssueSeverity {
  WARNING
  ERROR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
