# Employee Template Inputs
input EmployeeTemplateInput {
    tenantId: String!
    templateName: String!
    templateCode: String!
    description: String
    changeNotes: String
    applicableCategories: [String!]
    applicableGroups: [String!]
    applicableGrades: [String!]
    applicableCompanies: [ID!]
    applicableLocations: [ID!]
    applicableDivisions: [String!]
    applicableDepartments: [String!]
    applicableSections: [String!]
    applicableDesignations: [String!]
    applicableJobFunctions: [String!]
    applicableEmploymentTypes: [String!]

    # Field Configuration
    standardFields: JSON
    customFields: JSON

    # Assignment Criteria (The 9 Organizational Parameters)
    companyId: String
    locationId: String
    divisionId: String
    departmentId: String
    sectionId: String
    designationId: String
    jobFunctionId: String
    employmentTypeId: String
    gradeId: String

    isDefault: Boolean
    isActive: Boolean
    priority: Int
    version: String
    effectiveFrom: String
    effectiveTo: String
    createdBy: ID
    updatedBy: ID
}

input EmployeeTemplateSectionInput {
    templateId: ID!
    sectionName: String!
    sectionCode: String!
    sectionDescription: String
    sectionOrder: Int!
    sectionIcon: String
    isCollapsible: Boolean
    isExpandedByDefault: Boolean
    conditionalLogic: String
}

