    templateId: ID!
    sectionId: ID!
    fieldId: ID!
    displayOrder: Int!
    displayWidth: String
    isRequired: Boolean
    isReadonly: Boolean
    isVisible: Boolean
    isEditable: Boolean
    labelOverride: String
    helpTextOverride: String
    validationOverride: String
    defaultValue: String
    conditionalLogic: String
}

type Mutation {
    # Company mutations
    createCompany(input: CompanyInput!): Company!
    updateCompany(id: ID!, input: CompanyInput!): Company!
    deleteCompany(id: ID!): Boolean!

    # Company Statutory mutations
    updateCompanyStatutory(companyId: ID!, input: CompanyStatutoryInput!): CompanyStatutory!

    # Company General Settings mutations
    updateCompanyGeneralSettings(companyId: ID!, input: CompanyGeneralSettingsInput!): CompanyGeneralSettings!

    # Company Location mutations
    createCompanyLocation(companyId: ID!, input: CompanyLocationInput!): CompanyLocation!
    updateCompanyLocation(id: ID!, input: CompanyLocationInput!): CompanyLocation!
    deleteCompanyLocation(id: ID!): Boolean!

    # Company Bank Account mutations
    createCompanyBankAccount(companyId: ID!, input: CompanyBankAccountInput!): CompanyBankAccount!
    updateCompanyBankAccount(id: ID!, input: CompanyBankAccountInput!): CompanyBankAccount!
    deleteCompanyBankAccount(id: ID!): Boolean!
    setCompanyPrimaryBankAccount(id: ID!): CompanyBankAccount!

    # Department mutations
    createDepartment(input: DepartmentInput!): Department!
    updateDepartment(id: ID!, input: DepartmentInput!): Department!
    deleteDepartment(id: ID!): Boolean!

    # Designation mutations
    createDesignation(input: DesignationInput!): Designation!
    updateDesignation(id: ID!, input: DesignationInput!): Designation!
    deleteDesignation(id: ID!): Boolean!

    # Employee mutations moved to employee.graphqls

    # Country mutations
    createCountry(input: CountryInput!): Country!
    updateCountry(id: ID!, input: CountryInput!): Country!
    deleteCountry(id: ID!): Boolean!

    # State mutations
    createState(input: StateInput!): State!
    updateState(id: ID!, input: StateInput!): State!
    deleteState(id: ID!): Boolean!

    # City mutations
    createCity(input: CityInput!): City!
    updateCity(id: ID!, input: CityInput!): City!
    deleteCity(id: ID!): Boolean!

    # Division mutations
    createDivision(input: DivisionInput!): Division!
    updateDivision(id: ID!, input: DivisionInput!): Division!
    deleteDivision(id: ID!): Boolean!

    # Section mutations
    createSection(input: SectionInput!): Section!
    updateSection(id: ID!, input: SectionInput!): Section!
    deleteSection(id: ID!): Boolean!

    # JobFunction mutations
    createJobFunction(input: JobFunctionInput!): JobFunction!
    updateJobFunction(id: ID!, input: JobFunctionInput!): JobFunction!
    deleteJobFunction(id: ID!): Boolean!

    # EmploymentType mutations
    createEmploymentType(input: EmploymentTypeInput!): EmploymentType!
    updateEmploymentType(id: ID!, input: EmploymentTypeInput!): EmploymentType!
    deleteEmploymentType(id: ID!): Boolean!

    # Grade mutations
    createGrade(input: GradeInput!): Grade!
    updateGrade(id: ID!, input: GradeInput!): Grade!
    deleteGrade(id: ID!): Boolean!

    # Employee Template mutations
    createEmployeeTemplate(input: EmployeeTemplateInput!): EmployeeTemplate!
    updateEmployeeTemplate(id: ID!, input: EmployeeTemplateInput!): EmployeeTemplate!
    deleteEmployeeTemplate(id: ID!): Boolean!

    # Employee Template Section mutations
    createEmployeeTemplateSection(input: EmployeeTemplateSectionInput!): EmployeeTemplateSection!
    updateEmployeeTemplateSection(id: ID!, input: EmployeeTemplateSectionInput!): EmployeeTemplateSection!
    deleteEmployeeTemplateSection(id: ID!): Boolean!

    # Field Definition Master mutations
    createFieldDefinitionMaster(input: FieldDefinitionMasterInput!): FieldDefinitionMaster!
    updateFieldDefinitionMaster(id: ID!, input: FieldDefinitionMasterInput!): FieldDefinitionMaster!
    deleteFieldDefinitionMaster(id: ID!): Boolean!

    # Employee Template Field mutations
    createEmployeeTemplateField(input: EmployeeTemplateFieldInput!): EmployeeTemplateField!
    updateEmployeeTemplateField(id: ID!, input: EmployeeTemplateFieldInput!): EmployeeTemplateField!
    deleteEmployeeTemplateField(id: ID!): Boolean!
}
