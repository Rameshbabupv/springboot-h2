# Scalar Types
scalar JSON

# Company Types
type Company {
    id: ID!
    tenantId: String!
    code: String!
    name: String!
    shortName: String
    industry: String
    industryDescription: String
    companyType: String
    incorporationDate: String
    logoUrl: String
    addressLine1: String
    addressLine2: String
    country: String
    state: String
    city: String
    pincode: String
    primaryPhone: String
    alternatePhone: String
    email: String
    website: String
    contactName: String
    contactDesignation: String
    contactEmail: String
    contactPhone: String
    adminNotes: String
    isActive: Boolean!
    createdBy: String
    updatedBy: String
    createdAt: String
    updatedAt: String
    # Relations
    statutory: CompanyStatutory
    generalSettings: CompanyGeneralSettings
    locations: [CompanyLocation!]
    bankAccounts: [CompanyBankAccount!]
}

type CompanyStatutory {
    id: ID!
    # Tax Identifiers
    pan: String
    tan: String
    cin: String
    lin: String
    gstin: String
    # PF Configuration
    pfEnabled: Boolean!
    pfAccountNumber: String
    pfCeiling: Float
    pfEmployeeRate: Float
    pfEmployerRate: Float
    pfEmployerEpfRate: Float
    pfEmployerEpsRate: Float
    # ESI Configuration
    esiEnabled: Boolean!
    esiNumber: String
    esiCeiling: Float
    esiEmployeeRate: Float
    esiEmployerRate: Float
    # PT Configuration
    ptEnabled: Boolean!
    ptState: String
    ptRegistrationNumber: String
    ptRegistrationDate: String
    ptValidUpto: String
    # HR Config
    retirementAge: Int
    tdsType: String
    allowTdsOverride: Boolean
    applicableActs: String
    createdAt: String
    updatedAt: String
}

type CompanyGeneralSettings {
    id: ID!
    # Organizational Structure
    enableDivisions: Boolean!
    enableDepartment: Boolean!
    enableSection: Boolean!
    enableGrade: Boolean!
    # System Configuration
    currency: String
    dateFormat: String
    timeZone: String
    financialYearStart: String
    language: String
    createdAt: String
    updatedAt: String
}

type CompanyLocation {
    id: ID!
    type: String!
    name: String!
    code: String
    addressLine1: String!
    addressLine2: String
    state: String!
    city: String!
    pincode: String!
    # Location Statutory
    esiNumber: String
    pfNumber: String
    ptNumber: String
    gstin: String
    licenseNumber: String
    # Contact
    contactName: String!
    contactPhone: String!
    contactEmail: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type CompanyBankAccount {
    id: ID!
    beneficiaryName: String!
    accountName: String!
    bankName: String!
    branchName: String
    accountNumber: String!
    ifscCode: String!
    accountType: String!
    isPrimary: Boolean!
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type Department {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type Designation {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

# Employee type moved to employee.graphqls for complete 78-field definition

type Country {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    currencyCode: String
    phoneCode: String
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type State {
    id: ID!
    tenantId: String!
    countryId: ID!
    country: Country
    name: String!
    code: String!
    stateCode: String
    isUnionTerritory: Boolean!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type City {
    id: ID!
    tenantId: String!
    countryId: ID!
    country: Country
    stateId: ID!
    state: State
    name: String!
    code: String!
    pincode: String
    latitude: Float
    longitude: Float
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type Division {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type Section {
    id: ID!
    tenantId: String!
    department: Department!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type JobFunction {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    functionGroup: String!
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type EmploymentType {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

type Grade {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdBy: String
    createdAt: String
    updatedBy: String
    updatedAt: String
}

# Employee Template Types
type EmployeeTemplate {
    id: ID!
    tenantId: String!
    templateName: String!
    templateCode: String!
    description: String
    changeNotes: String
    applicableCategories: [String!]
    applicableGroups: [String!]
    applicableGrades: [String!]
    applicableCompanies: [ID!]
    applicableLocations: [ID!]
    applicableDivisions: [String!]
    applicableDepartments: [String!]
    applicableSections: [String!]
    applicableDesignations: [String!]
    applicableJobFunctions: [String!]
    applicableEmploymentTypes: [String!]

    # Field Configuration
    standardFields: JSON
    customFields: JSON

    # Assignment Criteria (The 9 Organizational Parameters)
    # null = applies to all, specific ID = applies only to that value
    companyId: String
    locationId: String
    divisionId: String
    departmentId: String
    sectionId: String
    designationId: String
    jobFunctionId: String
    employmentTypeId: String
    gradeId: String

    isDefault: Boolean!
    isActive: Boolean!
    priority: Int!
    version: String
    effectiveFrom: String
    effectiveTo: String
    createdBy: ID
    createdAt: String!
    updatedBy: ID
    updatedAt: String!
    sections: [EmployeeTemplateSection!]
}

type EmployeeTemplateSection {
    id: ID!
    templateId: ID!
    sectionName: String!
    sectionCode: String!
    sectionDescription: String
    sectionOrder: Int!
    sectionIcon: String
    isCollapsible: Boolean!
    isExpandedByDefault: Boolean!
    conditionalLogic: String
    createdAt: String!
    updatedAt: String!
    fields: [EmployeeTemplateField!]
}

type FieldDefinitionMaster {
    id: ID!
    tenantId: String!
    fieldName: String!
    fieldLabel: String!
    fieldCode: String
    fieldType: String!
    fieldCategory: String
    dataType: String!
    validationRules: String
    dropdownOptions: String
    isSystemField: Boolean!
    isCustomField: Boolean!
    isSearchable: Boolean!
    isRequiredByDefault: Boolean!
    helpText: String
    placeholderText: String
    status: String!
    createdBy: ID
    createdAt: String!
    updatedBy: ID
    updatedAt: String!
}

type EmployeeTemplateField {
    id: ID!
    templateId: ID!
    sectionId: ID!
    fieldId: ID!
    fieldDefinition: FieldDefinitionMaster
    displayOrder: Int!
    displayWidth: String!
    isRequired: Boolean!
    isReadonly: Boolean!
    isVisible: Boolean!
    isEditable: Boolean!
    labelOverride: String
    helpTextOverride: String
    validationOverride: String
    defaultValue: String
    conditionalLogic: String
    createdAt: String!
    updatedAt: String!
}

type Query {
    # Company queries
    companies: [Company!]!
    company(id: ID!): Company
    companyByCode(code: String!): Company
    companiesByTenant(tenantId: String!): [Company!]!
    activeCompanies: [Company!]!

    # Company Statutory queries
    companyStatutory(companyId: ID!): CompanyStatutory

    # Company General Settings queries
    companyGeneralSettings(companyId: ID!): CompanyGeneralSettings

    # Company Location queries
    companyLocations(companyId: ID!): [CompanyLocation!]!
    companyLocation(id: ID!): CompanyLocation

    # Company Bank Account queries
    companyBankAccounts(companyId: ID!): [CompanyBankAccount!]!
    companyBankAccount(id: ID!): CompanyBankAccount

    # Department queries
    departments: [Department!]!
    department(id: ID!): Department
    departmentsByTenant(tenantId: String!): [Department!]!
    activeDepartmentsByTenant(tenantId: String!): [Department!]!
    activeDepartments: [Department!]!
    searchDepartments(tenantId: String!, searchTerm: String): [Department!]!

    # Designation queries
    designations: [Designation!]!
    designation(id: ID!): Designation
    designationsByTenant(tenantId: String!): [Designation!]!
    activeDesignationsByTenant(tenantId: String!): [Designation!]!
    activeDesignations: [Designation!]!
    searchDesignations(tenantId: String!, searchTerm: String): [Designation!]!

    # Employee queries moved to employee.graphqls

    # Country queries
    countries: [Country!]!
    country(id: ID!): Country
    countriesByTenant(tenantId: String!): [Country!]!
    activeCountriesByTenant(tenantId: String!): [Country!]!
    activeCountries: [Country!]!
    searchCountries(tenantId: String!, searchTerm: String): [Country!]!

    # State queries
    states: [State!]!
    state(id: ID!): State
    statesByTenant(tenantId: String!): [State!]!
    activeStatesByTenant(tenantId: String!): [State!]!
    activeStates: [State!]!
    statesByCountry(countryId: ID!): [State!]!
    statesByTenantAndCountry(tenantId: String!, countryId: ID!): [State!]!
    searchStates(tenantId: String!, searchTerm: String): [State!]!

    # City queries
    cities: [City!]!
    city(id: ID!): City
    citiesByTenant(tenantId: String!): [City!]!
    activeCitiesByTenant(tenantId: String!): [City!]!
    activeCities: [City!]!
    citiesByState(stateId: ID!): [City!]!
    citiesByTenantAndState(tenantId: String!, stateId: ID!): [City!]!
    citiesByCountry(countryId: ID!): [City!]!
    citiesByTenantAndCountry(tenantId: String!, countryId: ID!): [City!]!
    searchCities(tenantId: String!, searchTerm: String): [City!]!

    # Division queries
    divisions: [Division!]!
    division(id: ID!): Division
    divisionsByTenant(tenantId: String!): [Division!]!
    activeDivisionsByTenant(tenantId: String!): [Division!]!
    activeDivisions: [Division!]!
    searchDivisions(tenantId: String!, searchTerm: String): [Division!]!

    # Section queries
    sections: [Section!]!
    section(id: ID!): Section
    sectionsByTenant(tenantId: String!): [Section!]!
    sectionsByDepartment(departmentId: ID!): [Section!]!
    activeSections: [Section!]!

    # JobFunction queries
    jobFunctions: [JobFunction!]!
    jobFunction(id: ID!): JobFunction
    jobFunctionsByTenant(tenantId: String!): [JobFunction!]!
    activeJobFunctionsByTenant(tenantId: String!): [JobFunction!]!
    activeJobFunctions: [JobFunction!]!
    jobFunctionsByGroup(tenantId: String!, functionGroup: String!): [JobFunction!]!
    searchJobFunctions(tenantId: String!, searchTerm: String): [JobFunction!]!

    # EmploymentType queries
    employmentTypes: [EmploymentType!]!
    employmentType(id: ID!): EmploymentType
    employmentTypesByTenant(tenantId: String!): [EmploymentType!]!
    activeEmploymentTypes: [EmploymentType!]!
    searchEmploymentTypes(tenantId: String!, searchTerm: String): [EmploymentType!]!

    # Grade queries
    grades: [Grade!]!
    grade(id: ID!): Grade
    gradesByTenant(tenantId: String!): [Grade!]!
    activeGrades: [Grade!]!
    searchGrades(tenantId: String!, searchTerm: String): [Grade!]!

    # Employee Template queries
    employeeTemplates(tenantId: String!): [EmployeeTemplate!]!
    employeeTemplate(id: ID!): EmployeeTemplate
    activeEmployeeTemplates(tenantId: String!): [EmployeeTemplate!]!

    # Employee Template Section queries
    employeeTemplateSections(templateId: ID!): [EmployeeTemplateSection!]!
    employeeTemplateSection(id: ID!): EmployeeTemplateSection

    # Field Definition Master queries
    fieldDefinitions(tenantId: String!): [FieldDefinitionMaster!]!
    fieldDefinition(id: ID!): FieldDefinitionMaster
    fieldDefinitionsByCategory(tenantId: String!, category: String!): [FieldDefinitionMaster!]!
    systemFieldDefinitions(tenantId: String!): [FieldDefinitionMaster!]!
    customFieldDefinitions(tenantId: String!): [FieldDefinitionMaster!]!

    # Employee Template Field queries
    employeeTemplateFields(sectionId: ID!): [EmployeeTemplateField!]!
    employeeTemplateField(id: ID!): EmployeeTemplateField

    # Validation queries
    employeeTemplateValidationRules(tenantId: String!, templateId: ID!): String!
}

