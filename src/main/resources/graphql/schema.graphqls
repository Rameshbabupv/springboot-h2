# Company Types
type Company {
    id: ID!
    tenantId: String!
    code: String!
    name: String!
    shortName: String
    industry: String
    industryDescription: String
    companyType: String
    incorporationDate: String
    logoUrl: String
    addressLine1: String
    addressLine2: String
    country: String
    state: String
    city: String
    pincode: String
    primaryPhone: String
    alternatePhone: String
    email: String
    website: String
    contactName: String
    contactDesignation: String
    contactEmail: String
    contactPhone: String
    adminNotes: String
    isActive: Boolean!
    createdBy: String
    updatedBy: String
    createdAt: String
    updatedAt: String
    # Relations
    statutory: CompanyStatutory
    generalSettings: CompanyGeneralSettings
    locations: [CompanyLocation!]
    bankAccounts: [CompanyBankAccount!]
}

type CompanyStatutory {
    id: ID!
    # Tax Identifiers
    pan: String
    tan: String
    cin: String
    lin: String
    gstin: String
    # PF Configuration
    pfEnabled: Boolean!
    pfAccountNumber: String
    pfCeiling: Float
    pfEmployeeRate: Float
    pfEmployerRate: Float
    pfEmployerEpfRate: Float
    pfEmployerEpsRate: Float
    # ESI Configuration
    esiEnabled: Boolean!
    esiNumber: String
    esiCeiling: Float
    esiEmployeeRate: Float
    esiEmployerRate: Float
    # PT Configuration
    ptEnabled: Boolean!
    ptState: String
    ptRegistrationNumber: String
    ptRegistrationDate: String
    ptValidUpto: String
    # HR Config
    retirementAge: Int
    tdsType: String
    allowTdsOverride: Boolean
    applicableActs: String
    createdAt: String
    updatedAt: String
}

type CompanyGeneralSettings {
    id: ID!
    # Organizational Structure
    enableDivisions: Boolean!
    enableDepartment: Boolean!
    enableSection: Boolean!
    enableGrade: Boolean!
    # System Configuration
    currency: String
    dateFormat: String
    timeZone: String
    financialYearStart: String
    language: String
    createdAt: String
    updatedAt: String
}

type CompanyLocation {
    id: ID!
    type: String!
    name: String!
    code: String
    addressLine1: String!
    addressLine2: String
    state: String!
    city: String!
    pincode: String!
    # Location Statutory
    esiNumber: String
    pfNumber: String
    ptNumber: String
    gstin: String
    licenseNumber: String
    # Contact
    contactName: String!
    contactPhone: String!
    contactEmail: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type CompanyBankAccount {
    id: ID!
    beneficiaryName: String!
    accountName: String!
    bankName: String!
    branchName: String
    accountNumber: String!
    ifscCode: String!
    accountType: String!
    isPrimary: Boolean!
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type Department {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type Designation {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type Employee {
    id: ID!
    tenantId: String!
    company: Company!
    empId: String!
    employeeName: String!
    gender: String
    dateOfBirth: String
    dateOfJoin: String!
    mobileNo: String
    emailId: String
    bloodGroup: String
    maritalStatus: String
    department: Department
    designation: Designation
    reportingManager: Employee
    basicSalary: Float
    grossSalary: Float
    ctc: Float
    aadharNo: String
    panNo: String
    uan: String
    coverPf: Boolean!
    pfNumber: String
    coverEsi: Boolean!
    esiNumber: String
    employeeStatus: String
    isActive: Boolean!
    createdAt: String
    updatedAt: String
}

type State {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type City {
    id: ID!
    tenantId: String!
    cityName: String!
    state: String!
    pincode: String
    isActive: Boolean!
    createdAt: String
}

type Division {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type Section {
    id: ID!
    tenantId: String!
    department: Department!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type JobFunction {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type EmploymentType {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean!
    createdAt: String
}

type Grade {
    id: ID!
    tenantId: String!
    name: String!
    code: String!
    level: Int
    minSalary: Float
    maxSalary: Float
    description: String
    isActive: Boolean!
    createdAt: String
}

type Query {
    # Company queries
    companies: [Company!]!
    company(id: ID!): Company
    companyByCode(code: String!): Company
    companiesByTenant(tenantId: String!): [Company!]!
    activeCompanies: [Company!]!

    # Company Statutory queries
    companyStatutory(companyId: ID!): CompanyStatutory

    # Company General Settings queries
    companyGeneralSettings(companyId: ID!): CompanyGeneralSettings

    # Company Location queries
    companyLocations(companyId: ID!): [CompanyLocation!]!
    companyLocation(id: ID!): CompanyLocation

    # Company Bank Account queries
    companyBankAccounts(companyId: ID!): [CompanyBankAccount!]!
    companyBankAccount(id: ID!): CompanyBankAccount

    # Department queries
    departments: [Department!]!
    department(id: ID!): Department
    departmentsByTenant(tenantId: String!): [Department!]!
    activeDepartments: [Department!]!

    # Designation queries
    designations: [Designation!]!
    designation(id: ID!): Designation
    designationsByTenant(tenantId: String!): [Designation!]!
    activeDesignations: [Designation!]!

    # Employee queries
    employees: [Employee!]!
    employee(id: ID!): Employee
    employeesByTenant(tenantId: String!): [Employee!]!
    employeesByCompany(companyId: ID!): [Employee!]!
    employeesByDepartment(departmentId: ID!): [Employee!]!
    activeEmployees: [Employee!]!
    employeesByStatus(status: String!): [Employee!]!

    # State queries
    states: [State!]!
    state(id: ID!): State
    statesByTenant(tenantId: String!): [State!]!
    activeStates: [State!]!

    # City queries
    cities: [City!]!
    city(id: ID!): City
    citiesByTenant(tenantId: String!): [City!]!
    citiesByState(state: String!): [City!]!
    activeCities: [City!]!

    # Division queries
    divisions: [Division!]!
    division(id: ID!): Division
    divisionsByTenant(tenantId: String!): [Division!]!
    activeDivisions: [Division!]!

    # Section queries
    sections: [Section!]!
    section(id: ID!): Section
    sectionsByTenant(tenantId: String!): [Section!]!
    sectionsByDepartment(departmentId: ID!): [Section!]!
    activeSections: [Section!]!

    # JobFunction queries
    jobFunctions: [JobFunction!]!
    jobFunction(id: ID!): JobFunction
    jobFunctionsByTenant(tenantId: String!): [JobFunction!]!
    activeJobFunctions: [JobFunction!]!

    # EmploymentType queries
    employmentTypes: [EmploymentType!]!
    employmentType(id: ID!): EmploymentType
    employmentTypesByTenant(tenantId: String!): [EmploymentType!]!
    activeEmploymentTypes: [EmploymentType!]!

    # Grade queries
    grades: [Grade!]!
    grade(id: ID!): Grade
    gradesByTenant(tenantId: String!): [Grade!]!
    activeGrades: [Grade!]!
}

# Company Inputs
input CompanyInput {
    tenantId: String!
    code: String!
    name: String!
    shortName: String
    industry: String
    industryDescription: String
    companyType: String
    incorporationDate: String
    logoUrl: String
    addressLine1: String
    addressLine2: String
    country: String
    state: String
    city: String
    pincode: String
    primaryPhone: String
    alternatePhone: String
    email: String
    website: String
    contactName: String
    contactDesignation: String
    contactEmail: String
    contactPhone: String
    adminNotes: String
    isActive: Boolean
}

input CompanyStatutoryInput {
    # Tax Identifiers
    pan: String
    tan: String
    cin: String
    lin: String
    gstin: String
    # PF Configuration
    pfEnabled: Boolean
    pfAccountNumber: String
    pfCeiling: Float
    pfEmployeeRate: Float
    pfEmployerRate: Float
    pfEmployerEpfRate: Float
    pfEmployerEpsRate: Float
    # ESI Configuration
    esiEnabled: Boolean
    esiNumber: String
    esiCeiling: Float
    esiEmployeeRate: Float
    esiEmployerRate: Float
    # PT Configuration
    ptEnabled: Boolean
    ptState: String
    ptRegistrationNumber: String
    ptRegistrationDate: String
    ptValidUpto: String
    # HR Config
    retirementAge: Int
    tdsType: String
    allowTdsOverride: Boolean
    applicableActs: String
}

input CompanyGeneralSettingsInput {
    enableDivisions: Boolean
    enableDepartment: Boolean
    enableSection: Boolean
    enableGrade: Boolean
    currency: String
    dateFormat: String
    timeZone: String
    financialYearStart: String
    language: String
}

input CompanyLocationInput {
    type: String!
    name: String!
    code: String
    addressLine1: String!
    addressLine2: String
    state: String!
    city: String!
    pincode: String!
    esiNumber: String
    pfNumber: String
    ptNumber: String
    gstin: String
    licenseNumber: String
    contactName: String!
    contactPhone: String!
    contactEmail: String
    isActive: Boolean
}

input CompanyBankAccountInput {
    beneficiaryName: String!
    accountName: String!
    bankName: String!
    branchName: String
    accountNumber: String!
    ifscCode: String!
    accountType: String!
    isPrimary: Boolean
    isActive: Boolean
}

input DepartmentInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input DesignationInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input EmployeeInput {
    tenantId: String!
    companyId: ID!
    empId: String!
    employeeName: String!
    gender: String
    dateOfBirth: String
    dateOfJoin: String!
    mobileNo: String
    emailId: String
    bloodGroup: String
    maritalStatus: String
    departmentId: ID
    designationId: ID
    reportingManagerId: ID
    basicSalary: Float
    grossSalary: Float
    ctc: Float
    aadharNo: String
    panNo: String
    uan: String
    coverPf: Boolean
    pfNumber: String
    coverEsi: Boolean
    esiNumber: String
    employeeStatus: String
    isActive: Boolean
}

input StateInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input CityInput {
    tenantId: String!
    cityName: String!
    state: String!
    pincode: String
    isActive: Boolean
}

input DivisionInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input SectionInput {
    tenantId: String!
    departmentId: ID!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input JobFunctionInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input EmploymentTypeInput {
    tenantId: String!
    name: String!
    code: String!
    description: String
    isActive: Boolean
}

input GradeInput {
    tenantId: String!
    name: String!
    code: String!
    level: Int
    minSalary: Float
    maxSalary: Float
    description: String
    isActive: Boolean
}

type Mutation {
    # Company mutations
    createCompany(input: CompanyInput!): Company!
    updateCompany(id: ID!, input: CompanyInput!): Company!
    deleteCompany(id: ID!): Boolean!

    # Company Statutory mutations
    updateCompanyStatutory(companyId: ID!, input: CompanyStatutoryInput!): CompanyStatutory!

    # Company General Settings mutations
    updateCompanyGeneralSettings(companyId: ID!, input: CompanyGeneralSettingsInput!): CompanyGeneralSettings!

    # Company Location mutations
    createCompanyLocation(companyId: ID!, input: CompanyLocationInput!): CompanyLocation!
    updateCompanyLocation(id: ID!, input: CompanyLocationInput!): CompanyLocation!
    deleteCompanyLocation(id: ID!): Boolean!

    # Company Bank Account mutations
    createCompanyBankAccount(companyId: ID!, input: CompanyBankAccountInput!): CompanyBankAccount!
    updateCompanyBankAccount(id: ID!, input: CompanyBankAccountInput!): CompanyBankAccount!
    deleteCompanyBankAccount(id: ID!): Boolean!
    setCompanyPrimaryBankAccount(id: ID!): CompanyBankAccount!

    # Department mutations
    createDepartment(input: DepartmentInput!): Department!
    updateDepartment(id: ID!, input: DepartmentInput!): Department!
    deleteDepartment(id: ID!): Boolean!

    # Designation mutations
    createDesignation(input: DesignationInput!): Designation!
    updateDesignation(id: ID!, input: DesignationInput!): Designation!
    deleteDesignation(id: ID!): Boolean!

    # Employee mutations
    createEmployee(input: EmployeeInput!): Employee!
    updateEmployee(id: ID!, input: EmployeeInput!): Employee!
    deleteEmployee(id: ID!): Boolean!

    # State mutations
    createState(input: StateInput!): State!
    updateState(id: ID!, input: StateInput!): State!
    deleteState(id: ID!): Boolean!

    # City mutations
    createCity(input: CityInput!): City!
    updateCity(id: ID!, input: CityInput!): City!
    deleteCity(id: ID!): Boolean!

    # Division mutations
    createDivision(input: DivisionInput!): Division!
    updateDivision(id: ID!, input: DivisionInput!): Division!
    deleteDivision(id: ID!): Boolean!

    # Section mutations
    createSection(input: SectionInput!): Section!
    updateSection(id: ID!, input: SectionInput!): Section!
    deleteSection(id: ID!): Boolean!

    # JobFunction mutations
    createJobFunction(input: JobFunctionInput!): JobFunction!
    updateJobFunction(id: ID!, input: JobFunctionInput!): JobFunction!
    deleteJobFunction(id: ID!): Boolean!

    # EmploymentType mutations
    createEmploymentType(input: EmploymentTypeInput!): EmploymentType!
    updateEmploymentType(id: ID!, input: EmploymentTypeInput!): EmploymentType!
    deleteEmploymentType(id: ID!): Boolean!

    # Grade mutations
    createGrade(input: GradeInput!): Grade!
    updateGrade(id: ID!, input: GradeInput!): Grade!
    deleteGrade(id: ID!): Boolean!
}
